generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                       @id @default(autoincrement())
  google_id               String                    @unique
  email                   String
  name                    String
  username                String                    @unique
  avatar_svg              String
  xp                      Int                       @default(0)
  created_at              DateTime                  @default(now())
  last_opened_problem_id  String?
  last_active             DateTime?
  contestParticipations   ContestParticipant[]
  contestSubmissions      ContestSubmission[]
  createdContests         Contest[]                 @relation("ContestCreator")
  conversationMemberships ConversationParticipant[]
  receivedFriendRequests  FriendRequest[]           @relation("FriendRequestReceiver")
  sentFriendRequests      FriendRequest[]            @relation("FriendRequestSender")
  sentMessages            Message[]                 @relation("MessageSender")
  notifications           Notification[]
  submissions             Submission[]

  @@index([google_id])
  @@map("users")
}

model Submission {
  id         Int      @id @default(autoincrement())
  user_id    Int
  problem_id String
  status     String
  time       String?
  memory     Float?
  created_at DateTime @default(now())
  users      User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([problem_id])
  @@index([user_id])
  @@map("submissions")
}

model Contest {
  id                 String               @id @default(uuid())
  title              String
  creator_id         Int
  is_public          Boolean              @default(false)
  starts_at          DateTime
  duration_minutes   Int
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  participants       ContestParticipant[]
  problems           ContestProblem[]
  contestSubmissions ContestSubmission[]
  creator            User                 @relation("ContestCreator", fields: [creator_id], references: [id])
  conversations      Conversation[]

  @@map("contests")
}

model ContestProblem {
  id         String            @id @default(uuid())
  contest_id String
  problem_id String
  order      Int
  difficulty ProblemDifficulty
  contest    Contest           @relation(fields: [contest_id], references: [id])

  @@unique([contest_id, problem_id])
  @@map("contest_problems")
}

model ContestParticipant {
  id          String   @id @default(uuid())
  contest_id  String
  user_id     Int
  total_score Int      @default(0)
  joined_at   DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [id])
  contest     Contest  @relation(fields: [contest_id], references: [id])

  @@unique([contest_id, user_id])
  @@map("contest_participants")
}

model ContestSubmission {
  id           String   @id @default(uuid())
  contest_id   String
  user_id      Int
  problem_id   String
  is_correct   Boolean
  score        Int      @default(0)
  submitted_at DateTime @default(now())
  user         User     @relation(fields: [user_id], references: [id])
  contest      Contest  @relation(fields: [contest_id], references: [id])

  @@map("contest_submissions")
}

model Conversation {
  id           String                    @id @default(uuid())
  type         ConversationType
  contest_id   String?
  created_at   DateTime                  @default(now())
  updated_at   DateTime                  @updatedAt
  participants ConversationParticipant[]
  contest      Contest?                  @relation(fields: [contest_id], references: [id])
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id                   String       @id @default(uuid())
  conversation_id      String
  user_id              Int
  last_seen_message_id String?
  joined_at            DateTime     @default(now())
  last_seen_message    Message?     @relation("LastSeenMessage", fields: [last_seen_message_id], references: [id])
  user                 User         @relation(fields: [user_id], references: [id])
  conversation         Conversation @relation(fields: [conversation_id], references: [id])

  @@unique([conversation_id, user_id])
  @@map("conversation_participants")
}

model Message {
  id              String                    @id @default(uuid())
  conversation_id String
  sender_id       Int
  type            MessageType
  content         String
  metadata        String?
  created_at      DateTime                  @default(now())
  lastSeenBy      ConversationParticipant[] @relation("LastSeenMessage")
  sender          User                      @relation("MessageSender", fields: [sender_id], references: [id])
  conversation    Conversation              @relation(fields: [conversation_id], references: [id])

  @@index([conversation_id, created_at])
  @@map("messages")
}

model Notification {
  id         String           @id @default(uuid())
  user_id    Int
  type       NotificationType
  data       String
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())
  user       User             @relation(fields: [user_id], references: [id])

  @@map("notifications")
}

model FriendRequest {
  id          String              @id @default(uuid())
  sender_id   Int
  receiver_id Int
  status      FriendRequestStatus @default(pending)
  created_at  DateTime            @default(now())
  updated_at  DateTime            @updatedAt
  receiver    User                @relation("FriendRequestReceiver", fields: [receiver_id], references: [id])
  sender      User                @relation("FriendRequestSender", fields: [sender_id], references: [id])

  @@map("friend_requests")
}

enum ConversationType {
  direct
  contest
}

enum MessageType {
  text
  problem_recommendation
  code_snippet
  contest_invite
}

enum NotificationType {
  friend_request
  friend_request_accepted
  friend_online
  contest_invite
  contest_starting
}

enum FriendRequestStatus {
  pending
  accepted
  rejected
}

enum ProblemDifficulty {
  easy
  medium
  hard
}
